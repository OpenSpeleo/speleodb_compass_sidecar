{
  "name": "speleodb-compass-sidecar-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && bun run scripts/build.ts",
    "build:release": "tsc --noEmit && bun run scripts/build.ts --release",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:ui": "bun run test && bun run test:browser"
  },
  "dependencies": {
    "@tauri-apps/api": ">=2.12.1 <3",
    "react": ">=19.2.7 <20",
    "react-dom": ">=19.2.7 <20"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1 <11",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": ">=2.12.1 <3",
    "@testing-library/jest-dom": ">=6.10.0 <7",
    "@testing-library/react": ">=16.3.2 <17",
    "@testing-library/user-event": ">=14.6.7 <15",
    "@types/node": ">=25.9.4 <26",
    "@types/react": ">=19.3.0 <20",
    "@types/react-dom": ">=19.3.0 <20",
    "@vitejs/plugin-react": ">=6.0.3 <7",
    "eslint": ">=10.6.0 <11",
    "eslint-plugin-react-hooks": ">=7.1.1 <8",
    "jsdom": ">=29.1.1 <30",
    "prettier": ">=3.9.9 <4",
    "typescript": ">=6.0.3 <7",
    "typescript-eslint": ">=8.62.1 <9",
    "vite": ">=8.1.3 <9",
    "vitest": ">=4.1.9 <5"
  }
}
