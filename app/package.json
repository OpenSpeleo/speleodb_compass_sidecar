{
  "name": "speleodb-compass-sidecar-ui",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build": "tsc --noEmit && bun run scripts/build.ts",
    "build:release": "tsc --noEmit && bun run scripts/build.ts --release",
    "dev": "vite",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:ui": "bun run test && bun run test:browser",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": ">=19.2.7 <20",
    "react-dom": ">=19.2.7 <20",
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@eslint/js": ">=10.0.1 <11",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": ">=19.3.0 <20",
    "@types/react-dom": ">=19.3.0 <20",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": ">=7.1.1 <8",
    "jsdom": ">=30.0.1 <30.1",
    "prettier": "^3.9.10",
    "typescript": ">=6.0.3 <6.1",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
